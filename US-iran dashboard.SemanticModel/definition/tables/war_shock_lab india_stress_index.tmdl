table 'war_shock_lab india_stress_index'
	lineageTag: 0340f7a4-ab79-465f-a526-ad00a16a475a

	/// Composite India War Stress Index - a z-score blend of oil, equity, FII and INR components. Roughly zero at pre-war baseline; observed range is about -1.3 to 8.2.
	measure 'Stress Index' = AVERAGE ( 'war_shock_lab india_stress_index'[stress_index] )
		formatString: #,##0.00
		displayFolder: Stress
		lineageTag: fc28f0a1-efbc-4945-8432-ed3dc0da8612

	/// Highest stress index reading in context.
	measure 'Peak Stress Index' = MAX ( 'war_shock_lab india_stress_index'[stress_index] )
		formatString: #,##0.00
		displayFolder: Stress
		lineageTag: 2cdf117d-5dc8-4789-95df-b153f662d32e

	/// Worst Nifty drawdown from the pre-war peak, in percentage points (not a fraction). Stored positive, so MAX is the deepest drawdown.
	measure 'Nifty Drawdown %' = MAX ( 'war_shock_lab india_stress_index'[nifty_drawdown_pct] )
		formatString: 0.00"%"
		displayFolder: Stress
		lineageTag: 318a8307-aa53-459e-9861-f1af8ed42a32

	/// Oil component z-score contributing to the composite stress index.
	measure 'Z Oil' = AVERAGE ( 'war_shock_lab india_stress_index'[z_oil] )
		formatString: #,##0.00
		displayFolder: Stress\Components
		lineageTag: 780bf4bf-bc12-4ccc-927f-cd5318eb0a91

	/// Equity component z-score contributing to the composite stress index.
	measure 'Z Equity' = AVERAGE ( 'war_shock_lab india_stress_index'[z_equity] )
		formatString: #,##0.00
		displayFolder: Stress\Components
		lineageTag: 3750ff59-560c-45b4-852a-46c9f725acf4

	/// FII-flow component z-score contributing to the composite stress index.
	measure 'Z FII' = AVERAGE ( 'war_shock_lab india_stress_index'[z_fii] )
		formatString: #,##0.00
		displayFolder: Stress\Components
		lineageTag: 6f963262-728f-4e93-8f1a-f3f601f28777

	/// Rupee component z-score contributing to the composite stress index.
	measure 'Z INR' = AVERAGE ( 'war_shock_lab india_stress_index'[z_inr] )
		formatString: #,##0.00
		displayFolder: Stress\Components
		lineageTag: ef0b5719-5791-45d8-a070-4986f0c8a941

