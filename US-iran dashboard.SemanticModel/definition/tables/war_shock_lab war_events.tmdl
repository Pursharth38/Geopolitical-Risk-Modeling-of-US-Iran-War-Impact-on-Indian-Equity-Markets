table 'war_shock_lab war_events'
	lineageTag: ed3daa0f-76fc-4cac-8cd4-b4aa2509ccef

	/// Number of catalogued war events in context.
	measure 'Event Count' = COUNTROWS ( 'war_shock_lab war_events' )
		formatString: #,##0
		displayFolder: Events
		lineageTag: 91ed9fce-0657-4742-aafe-c44aa1d50b72

	/// Highest event severity score in context. Use for sizing or colouring event markers on a timeline.
	measure 'Max Event Severity' = MAX ( 'war_shock_lab war_events'[severity_score] )
		formatString: 0
		displayFolder: Events
		lineageTag: 527d68f4-da04-4ae7-9cce-1b8f729af57a

