table 'war_shock_lab daily_panel'
	lineageTag: a07669f7-2a04-40b7-bd85-68ce42c8626f

	/// Nifty 50 index level. Period average when more than one day is in context.
	measure 'Nifty Level' = AVERAGE ( 'war_shock_lab daily_panel'[nifty_level] )
		formatString: #,##0
		displayFolder: Equity
		lineageTag: e8b0a7e6-fbe8-461b-a964-b83653dd37f8

	/// Sensex index level. Period average when more than one day is in context.
	measure 'Sensex Level' = AVERAGE ( 'war_shock_lab daily_panel'[sensex_level] )
		formatString: #,##0
		displayFolder: Equity
		lineageTag: e163694c-8228-4ff9-8c04-0346a2106854

	/// Average daily Nifty return. Stored as a fraction. Do not read this as a period return - use Nifty Period Return % for that.
	measure 'Nifty Daily Return' = AVERAGE ( 'war_shock_lab daily_panel'[nifty_return] )
		formatString: 0.00%
		displayFolder: Equity
		lineageTag: 1881c7d3-f2f9-40a7-a797-612d5def17dd

	/// Nifty return from first to last trading day in context. Use this for phase-over-phase comparisons.
	measure 'Nifty Period Return %' =
			VAR _minDate = MIN ( 'war_shock_lab daily_panel'[date] )
			VAR _maxDate = MAX ( 'war_shock_lab daily_panel'[date] )
			VAR _first = CALCULATE ( AVERAGE ( 'war_shock_lab daily_panel'[nifty_level] ), 'war_shock_lab daily_panel'[date] = _minDate )
			VAR _last = CALCULATE ( AVERAGE ( 'war_shock_lab daily_panel'[nifty_level] ), 'war_shock_lab daily_panel'[date] = _maxDate )
			RETURN
			    DIVIDE ( _last - _first, _first )
		formatString: 0.00%
		displayFolder: Equity
		lineageTag: a6a6643e-b798-4357-81a9-1558676bfdeb

	/// USD/INR as carried on the daily panel. Prefer [USD INR] from fx_rates; this exists so the panel can be charted without a second table.
	measure 'USD INR (Panel)' = AVERAGE ( 'war_shock_lab daily_panel'[usd_inr] )
		formatString: #,##0.00
		displayFolder: FX
		lineageTag: 532eabdd-0531-44fb-bf41-a6edf89611a0

