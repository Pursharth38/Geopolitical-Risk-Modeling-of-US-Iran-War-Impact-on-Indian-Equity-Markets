table 'war_shock_lab india_stress_panel'
	lineageTag: bc38b436-66c6-4bba-bc34-e03632e003f0

	/// India CPI inflation in percentage points (not a fraction). Sourced monthly and carried forward on the daily panel.
	measure 'CPI Inflation' = AVERAGE ( 'war_shock_lab india_stress_panel'[cpi] )
		formatString: 0.00"%"
		displayFolder: Macro
		lineageTag: 0804258d-9204-42f2-9a4d-9938c2cd415d

	/// India WPI inflation in percentage points (not a fraction).
	measure 'WPI Inflation' = AVERAGE ( 'war_shock_lab india_stress_panel'[wpi] )
		formatString: 0.00"%"
		displayFolder: Macro
		lineageTag: bd3fbdd0-567d-4654-8393-e4ca7dc127cc

	/// India 10-year government bond yield in percentage points (not a fraction).
	measure 'G-Sec 10Y Yield' = AVERAGE ( 'war_shock_lab india_stress_panel'[gsec_10y_yield] )
		formatString: 0.00"%"
		displayFolder: Macro
		lineageTag: 0b71e8a6-504e-42e2-a584-48046bfe4e78

	/// Estimated current account deficit impact. Check units against the Milestone 3 notebook before quoting on a card.
	measure 'CAD Estimate' = AVERAGE ( 'war_shock_lab india_stress_panel'[cad_estimate] )
		formatString: #,##0.00
		displayFolder: Macro
		lineageTag: 5b973916-f79c-4334-94da-fa8ecb463cd4

	/// Trailing 30-day realised Nifty volatility, stored as a fraction.
	measure 'Nifty Volatility 30D' = AVERAGE ( 'war_shock_lab india_stress_panel'[nifty_vol_30d] )
		formatString: 0.00%
		displayFolder: Equity
		lineageTag: 5eedf298-aabe-4029-8f9f-0a64f2e85802

